# Preserve Unix line endings in the patch applied to Mesa on macOS.
nvk/nvk-macos.patch text eol=lf

# Keep the package helper and its regression tests portable.
build/stage_package.py text eol=lf
tools/test_stage_package.py text eol=lf

# Unified patch context includes space-only lines by definition.
zink/mesa-zink-nvk.patch text eol=lf whitespace=-blank-at-eol
video/nvenc-turing.patch text eol=lf whitespace=-blank-at-eol
nvk/nvk-small-bar-memory.patch text eol=lf whitespace=-blank-at-eol
